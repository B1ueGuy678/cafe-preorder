# ---- 数据库 ----
# 开发环境：SQLite（零安装即可跑通全流程）
DATABASE_URL="file:./dev.db"

# 生产库**不要**写在这里：.env 只服务于本地开发（SQLite）。
# 初始化生产库用临时环境变量 + 脚本，跑完自动还原：
#   $env:DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
#   node scripts/db-init-prod.mjs
# Vercel 上则由 vercel.json 的 buildCommand 自动切到 postgresql 生成 Client。

# ---- 运行环境 ----
NODE_ENV="development"

# ---- 支付（阶段 2 为模拟支付，无需任何密钥）----
# MOCK      = 模拟支付恒成功（默认）
# MOCK_FAIL = 模拟支付失败：下单返回 402 且不落单，用于演练支付失败路径
# 真实支付接入时在此放置密钥，且 .env 永不入库（见 .gitignore）
PAY_MODE="MOCK"

# ---- 定时兜底（阶段 6 部署用）----
# 配置后 /api/cron/auto-cancel 可用（需带 Authorization: Bearer <值>）；
# 不配置则端点直接 503 禁用。Vercel Cron 会自动带上这个头
CRON_SECRET=""

# ---- 店员端口令（阶段 2 口令门）----
# 配置后 /staff 必须输入口令；留空时开发环境放行、生产环境一律拒绝
# 连续 5 次错误口令会锁定 5 分钟（阶段 3 / R-5）
STAFF_PASSCODE=""
