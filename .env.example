# ---- 数据库 ----
# 开发环境：SQLite（零安装即可跑通全流程）
DATABASE_URL="file:./dev.db"

# 生产环境切换 Postgres 时改成类似：
# DATABASE_URL="postgresql://user:password@host:5432/cafe?schema=public"

# ---- 运行环境 ----
NODE_ENV="development"

# ---- 支付（阶段 2 为模拟支付，无需任何密钥）----
# 真实支付接入时在此放置密钥，且 .env 永不入库（见 .gitignore）
PAY_MODE="MOCK"
